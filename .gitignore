# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Upstream sync scratch (local-only, never committed)
.upstream-scratch/

# Analysis / review command output (transient, local-only)
.codebase-map/
.team-review/
.marketplace-review/
.frontend-review/
.peer-review/
.playwright-mcp/

# Distribution archives never belong in the tree
plugins/**/*.zip

# The root package.json is Pi's generated catalog, not a Node project. Nothing
# here declares a dependency, but `pi install git:` runs `npm install` on the
# clone, and a local run would otherwise leave these behind.
node_modules/
package-lock.json

# Project-local run records and generated coordination metadata
/.daodan*/
/.source-reading-publish/
/.source-reading-tmp/
/xray-step2-verification/
/.moe/
/exports/*/plugins/.*.lock
/.tritech/
.jcode/local/

# Office benchmark and verification scratch (local-only, kept on disk, never committed)
/office-conversion-benchmark/
/office-verification-tmp/
