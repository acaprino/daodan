<?xml version="1.0" encoding="utf-8"?>
<!-- Mono.Cecil only from the package Daodan carries, checked by sha256 (`packages`); the recorder's reference
     assemblies (NETStandard.Library) from NuGet's own feed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="daodan" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="daodan">
      <package pattern="Mono.Cecil" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
