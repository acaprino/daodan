<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>shop</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>
  <modules>
    <module>core</module>
  </modules>
  <profiles>
    <profile>
      <!-- active by default: Maven builds extras, the module list above does not name it -->
      <id>extras</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <modules><module>extras</module></modules>
    </profile>
    <profile>
      <!-- only with -Dlegacy: not in the default reactor -->
      <id>legacy</id>
      <activation><property><name>legacy</name></property></activation>
      <modules><module>legacy</module></modules>
    </profile>
  </profiles>
</project>
