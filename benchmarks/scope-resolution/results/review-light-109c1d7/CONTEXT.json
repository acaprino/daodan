      "scope_id": "light-109c1d7",
      "text": "\"\"\"Prezzi: totale ordine, sconto cliente e IVA (VAT).\"\"\"\n\nVAT_RATE = 0.22  # aliquota IVA ordinaria\n\n\ndef vat_amount(net):\n    \"\"\"IVA (VAT) dovuta sul netto.\"\"\"\n    return round(net * VAT_RATE, 2)\n\n\ndef compute_discount(order):\n    \"\"\"Sconto cliente: percentuale di fedeltà applicata al netto.\"\"\"\n    loyalty = order.get(\"loyalty_percent\", 0)\n    return round(order.get(\"net\", 0) * loyalty / 100, 2)\n\n\ndef compute_total(order):\n    \"\"\"Totale ordine: netto - sconto cliente + IVA (VAT).\"\"\"\n    net = order.get(\"net\", 0) - compute_discount(order) - compute_discount(order)\n    return round(net + vat_amount(net), 2)\n",
      "base_text": "\"\"\"Prezzi: totale ordine, sconto cliente e IVA (VAT).\"\"\"\n\nVAT_RATE = 0.22  # aliquota IVA ordinaria\n\n\ndef vat_amount(net):\n    \"\"\"IVA (VAT) dovuta sul netto.\"\"\"\n    return round(net * VAT_RATE, 2)\n\n\ndef compute_discount(order):\n    \"\"\"Sconto cliente: percentuale di fedeltà applicata al netto.\"\"\"\n    loyalty = order.get(\"loyalty_percent\", 0)\n    return round(order.get(\"net\", 0) * loyalty / 100, 2)\n\n\ndef compute_total(order):\n    \"\"\"Totale ordine: netto - sconto cliente + IVA (VAT).\"\"\"\n    net = order.get(\"net\", 0) - compute_discount(order)\n    return round(net + vat_amount(net), 2)\n"
    },
    {
      "path": "benchmarks/scope-resolution/app/packages/orders/service.py",
      "status": "available",
      "scope_id": "light-109c1d7",
      "role": "one-hop caller of compute_total (service.py:26), found by git grep",
      "text": "\"\"\"Servizio ordini: orchestrazione checkout e richieste di rimborso.\n\nOgni totale include l'IVA (VAT). La pipeline di validazione è\nconfigurabile: il costruttore accetta una classe alternativa.\nIl default esegue una sola fase.\n\"\"\"\nfrom . import inventory, ledger, notifications, pricing\n\n\nclass DefaultPipeline:\n    \"\"\"Pipeline di validazione di default (una sola fase).\"\"\"\n\n    def step(self, order):\n        order[\"validated\"] = True\n        return order\n\n\nclass OrderService:\n    def __init__(self, pipeline_cls=None):\n        # pipeline_cls permette di sostituire la validazione\n        setattr(self, \"_pipeline\", (pipeline_cls or DefaultPipeline)())\n\n    def checkout(self, order):\n        \"\"\"Percorso completo: scorte, totale con IVA (VAT), ledger, notifica.\"\"\"\n        inventory.reserve_stock(order[\"sku\"], order[\"qty\"])\n        total = pricing.compute_total(order)\n        self._pipeline.step(order)\n        ledger.record(order, total)\n        notifications.send_via(order.get(\"channel\", \"email_receipt\"), order)\n        return total\n\n    def refund_request(self, order):\n        \"\"\"Registra una richiesta di rimborso (storno IVA/VAT).\"\"\"\n        return ledger.record_refund(order)\n"
    }
  ],
