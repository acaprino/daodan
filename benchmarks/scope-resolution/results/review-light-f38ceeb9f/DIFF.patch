@@ -0,0 +1,18 @@
+"""Oracolo del difetto seminato: il totale ordine applica lo sconto cliente una volta sola.
+
+Rosso di proposito sul commit del seme: compute_total sottrae compute_discount due volte.
+Atteso: netto 100, fedeltà 10% -> sconto 10, netto 90, IVA 22% -> totale 109.8.
+"""
+import sys
+from pathlib import Path
+
+PACKAGES = Path(__file__).resolve().parent / "app" / "packages"
+
+
+def test_total_applies_loyalty_discount_once():
+    sys.path.insert(0, str(PACKAGES))
+    try:
+        from orders import pricing
+    finally:
+        sys.path.remove(str(PACKAGES))
+    assert pricing.compute_total({"net": 100, "loyalty_percent": 10}) == 109.8
