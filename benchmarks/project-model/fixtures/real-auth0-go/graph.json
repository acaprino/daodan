 "gaps": [
  {"what": "the two apps are the same sample written twice: same routes, same cookie name, same port; nothing joins them and a link between them is false", "class": "forbidden_link"},
  {"what": "the handlers of /login, /callback and (Quickstart) /logout are closures returned by a function: the route binds to the function that returns them", "class": "anonymous_handler"},
  {"what": "the Quickstart registers its routes on net/http's ServeMux, with no framework: no method is declared, and the pattern / also answers every unknown path", "class": "no_framework"},
  {"what": "Auth0 calls /callback from outside: the caller is the tenant, configured by AUTH0_CALLBACK_URL, and no file of the project holds that call", "class": "inbound_from_external"},
  {"what": "in 01-Login the session cookie is signed with the literal key \"secret\" (router.go:27), in the Quickstart with SESSION_SECRET", "class": "note"},
  {"what": "jQuery, Bootstrap, Font Awesome and js.cookie come from CDN URLs or a vendored file in the templates, not from a manifest", "class": "undeclared_dependency"},
  {"what": "run_and_observe cannot complete the login: it needs a real Auth0 tenant and a test user, which only the project's CI secrets hold", "class": "needs_credentials"}
