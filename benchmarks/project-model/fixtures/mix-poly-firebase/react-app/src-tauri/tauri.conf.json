{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shop",
  "version": "0.1.0",
  "identifier": "com.acme.shop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "Shop", "width": 1000, "height": 700}]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
