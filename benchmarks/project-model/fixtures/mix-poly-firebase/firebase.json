{
  "functions": [
    {
      "source": "functions",
      "codebase": "ts",
      "runtime": "nodejs20",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    },
    {
      "source": "functions-python",
      "codebase": "py",
      "runtime": "python312"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "react-app/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  },
  "emulators": {
    "functions": {"port": 5001},
    "firestore": {"port": 8080},
    "hosting": {"port": 5000}
  }
}
