{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "host",
      "inherits": "base",
      "cacheVariables": { "SENSOR_BUILD_TESTS": "ON" }
    },
    {
      "name": "cortex-m4",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "SENSOR_BOARD": "nucleo_f401re", "SENSOR_BUILD_TESTS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "cortex-m4", "configurePreset": "cortex-m4" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } }
  ]
}
