{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daodan",
  "identifier": "dev.daodan.desktop",
  "build": {
    "frontendDist": "../start"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Daodan",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["main", "start"]
    }
  },
  "bundle": { "active": false }
}
