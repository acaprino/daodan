{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // shortcut: src alone: test/ and vite.config.ts import node:*, whose types are @types/node, until it is in the lockfile (written in CI)
  "include": ["src"]
}
